{
  "name": "migrate-barrel-imports",
  "version": "5.0.0",
  "description": "A CLI tool to migrate barrel imports in JavaScript/TypeScript monorepos",
  "keywords": [
    "barrel",
    "cli",
    "import",
    "imports",
    "javascript",
    "migrate",
    "monorepo",
    "tool",
    "typescript"
  ],
  "homepage": "https://github.com/brandhaug/migrate-barrel-imports#readme",
  "bugs": {
    "url": "https://github.com/brandhaug/migrate-barrel-imports/issues"
  },
  "license": "MIT",
  "author": "Martin Brandhaug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandhaug/migrate-barrel-imports.git"
  },
  "bin": {
    "migrate-barrel-imports": "dist/index.js"
  },
  "workspaces": [],
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "prepare": "git config core.hooksPath .githooks",
    "test": "bun test --isolate",
    "dead-code": "fallow dead-code --fail-on-regression",
    "validate": "npm run lint && npm run format:check && npm run test && npm run dead-code"
  },
  "dependencies": {
    "@babel/generator": "8.0.0",
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.0.4",
    "@babel/types": "8.0.4",
    "@clack/prompts": "1.7.0",
    "fast-glob": "3.3.3",
    "micromatch": "4.0.8"
  },
  "devDependencies": {
    "@types/babel__generator": "catalog:",
    "@types/babel__traverse": "catalog:",
    "@types/micromatch": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@babel/generator": "8.0.0",
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.0.4",
    "@babel/types": "8.0.4",
    "@clack/prompts": "1.7.0",
    "fast-glob": "3.3.3",
    "micromatch": "4.0.8",
    "@types/babel__generator": "7.27.0",
    "@types/babel__traverse": "7.28.0",
    "@types/micromatch": "4.0.10",
    "@types/node": "26.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.10.7"
  }
}
