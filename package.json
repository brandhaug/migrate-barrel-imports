{
	"name": "migrate-barrel-imports",
	"version": "5.0.9",
	"description": "A CLI tool to migrate barrel imports in JavaScript/TypeScript monorepos",
	"keywords": [
		"barrel",
		"cli",
		"import",
		"imports",
		"javascript",
		"migrate",
		"monorepo",
		"tool",
		"typescript"
	],
	"homepage": "https://github.com/brandhaug/migrate-barrel-imports#readme",
	"bugs": {
		"url": "https://github.com/brandhaug/migrate-barrel-imports/issues"
	},
	"license": "MIT",
	"author": "Martin Brandhaug",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brandhaug/migrate-barrel-imports.git"
	},
	"bin": {
		"migrate-barrel-imports": "dist/index.js"
	},
	"workspaces": [],
	"files": [
		"dist/"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "bun check",
		"start": "node dist/index.js",
		"lint": "oxlint --type-aware",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"prepare": "git config core.hooksPath .githooks",
		"test": "bun test --isolate",
		"dead-code": "fallow dead-code --fail-on-regression",
		"validate": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run dead-code"
	},
	"dependencies": {
		"@babel/generator": "8.0.0",
		"@babel/parser": "8.0.4",
		"@babel/traverse": "8.0.4",
		"@babel/types": "8.0.4",
		"@clack/prompts": "1.7.0",
		"picomatch": "4.0.7",
		"tinyglobby": "0.2.17"
	},
	"devDependencies": {
		"@types/babel__generator": "catalog:",
		"@types/babel__traverse": "catalog:",
		"@types/node": "catalog:",
		"@types/picomatch": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"catalog": {
		"@types/babel__generator": "7.27.0",
		"@types/babel__traverse": "7.28.0",
		"@types/picomatch": "4.0.3",
		"@types/node": "26.6.5",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "7.0.2"
	}
}
